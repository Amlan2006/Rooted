# Copy to .env (gitignored). setup.mjs fills the Hedera values; never commit a real key.
# Operator = merchant pay-to account. setup.mjs generates the key; fund its EVM address once at portal.hedera.com/faucet.
HEDERA_OPERATOR_KEY=
HEDERA_OPERATOR_ID=
# Paying agent account, created by setup.mjs from the operator (20 HBAR).
AGENT_ID=
AGENT_KEY=
# Optional HCS audit topic (node setup.mjs --hcs). Each paid call appends {block_hash, report_sha256, payment_tx, amount, asset}.
ROOTED_AGENT_HCS_TOPIC=
# Where the agent buys reports (the dashboard running with ROOTED_X402_ENABLED=true).
ROOTED_PUBLIC_URL=http://127.0.0.1:3000
# Spend controls, atomic units of the asset (tinybars for HBAR; 1 HBAR = 100000000).
ROOTED_EXPECTED_PAY_TO=
ROOTED_X402_HEDERA_ASSET=0.0.0
MAX_PER_REQUEST=1000000
SESSION_BUDGET=5000000
# Budget window label; default is the UTC date, so SESSION_BUDGET is a daily budget.
# ROOTED_AGENT_SESSION=
