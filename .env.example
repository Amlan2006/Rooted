# Local PostgreSQL; keep this password consistent with DATABASE_URL.
ROOTED_DB_PASSWORD=rooted-local-only
DATABASE_URL=postgres://rooted:rooted-local-only@127.0.0.1:54329/rooted?sslmode=disable
ROOTED_LISTEN_ADDR=127.0.0.1:8080
ROOTED_NETWORK=sepolia
ROOTED_CHAIN_ID=11155111
ROOTED_GENESIS_ROOT=0xd8ea171f3c94aea21ebc42a1ed61052acf3f9209c00e4efbaaddac09ed9b8078
ROOTED_REQUEST_TIMEOUT=15s
# Phase 3: one active collector per network/source identity.
ROOTED_WATCH_ENABLED=true
ROOTED_STREAM_ENABLED=true
ROOTED_SOURCE_ID=beacon
ROOTED_POLL_INTERVAL=12s
ROOTED_POLL_LOOKBACK=2
ROOTED_MAX_CATCHUP=4
# Local receipt thresholds, separate from Ethereum protocol deadlines.
ROOTED_LOCAL_LATE_AFTER=2s
ROOTED_LOCAL_MISSING_AFTER=8s
ROOTED_PTC_SIZE=512
# Zero keeps PTC/blob verdicts unknown until network quorum is verified.
ROOTED_PTC_QUORUM=0
# Public-provider polling defaults. For the Nimbus/Geth SSH tunnels, use
# docs/SEPOLIA_NODE.md and the existing local .env; do not replace it with this file.
# Export these variables for both the Go backend and the Phase 1 probes.
ROOTED_EXECUTION_URL=https://ethereum-sepolia-rpc.publicnode.com
ROOTED_BEACON_URL=https://ethereum-sepolia-beacon-api.publicnode.com
ROOTED_TRACE_URL=https://sepolia.drpc.org
# Phase 5 analysis anchor and local fork RPC (fork must stay loopback-only).
ROOTED_ANALYSIS_ANCHOR_NUMBER=0xf4240
ROOTED_ANALYSIS_ANCHOR_HASH=0xaad11ee5a3b4b037a4cef3afd30398bf8b0f73e702cf86f86e3f4eaa9d7d39a2
ROOTED_FORK_RPC=http://127.0.0.1:8547
# Dashboard server-only backend origin; never expose credentials in this value.
ROOTED_BACKEND_URL=http://127.0.0.1:8080
# Independent frame devnet; never use these endpoints as Sepolia providers.
ROOTED_FRAME_ENABLED=true
ROOTED_FRAME_STREAM_ENABLED=true
ROOTED_FRAME_NETWORK=frame-devnet
ROOTED_FRAME_CHAIN_ID=1337
ROOTED_FRAME_GENESIS_HASH=0x196a1589ac71e2f305b1fbc7bfd23e55367f9fd6eb9da97e2f572c2791e17bbc
ROOTED_FRAME_EXECUTION_URL=https://altmempool.forshtat.com
ROOTED_FRAME_GATEWAY_URL=https://altmempoolgateway.forshtat.com/rpc
ROOTED_FRAME_MINER_URL=https://altmempool.forshtat.com/rpc
ROOTED_FRAME_POLL_INTERVAL=20s
ROOTED_FRAME_OBSERVATION_WINDOW=2m
